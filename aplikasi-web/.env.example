# =====================================================================
#  TEMPLATE ENV — aplikasi-web (SISTEM INFORMASI TUKIN & UANG MAKAN)
#  Salin file ini menjadi .env.local lalu isi nilainya.
#  JANGAN pernah commit .env.local / membagikan isinya.
#  Variabel yang sama juga harus diisi di Vercel → Settings → Environment
#  Variables (Production + Preview).
#  Status 10 Nov 2026: keputusan = penyimpanan berkas di Google Drive,
#  HUKDIS/TB aktif sejak awal. Supabase tetap dipakai untuk Auth + database.
# =====================================================================

# ─────────────────────────────────────────────────────────────────────
# 1. SUPABASE (WAJIB) — Auth + PostgreSQL
#    Dashboard → project → Connect / Settings → API Keys
#    Kunci baru: sb_publishable_... (boleh di browser)
#                sb_secret_...      (HANYA server, bypass RLS)
# ─────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://GANTI-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_GANTI_INI
SUPABASE_SECRET_KEY=sb_secret_GANTI_INI

# Alias lama (hanya bila project belum punya kunci baru; kosongkan kalau
# sudah memakai kunci sb_publishable_/sb_secret_ di atas)
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────
# 2. GOOGLE DRIVE (WAJIB — tempat menyimpan berkas presensi & hasil)
#    Google Cloud Console → APIs & Services → Credentials
#    OAuth client type: Web application
# ─────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=GANTI.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GANTI
# Samakan persis dengan "Authorized redirect URIs" di Google Cloud
GOOGLE_REDIRECT_URI=http://localhost:3000/api/drive/oauth/callback
# Scope yang diminta (dipisah spasi). drive.readonly untuk membaca folder
# presensi yang sudah ada; drive.file untuk membuat folder & file hasil.
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/drive.file

# Opsional: isi folder induk di Drive (boleh juga diisi nanti dari /admin/drive)
DRIVE_FOLDER_ID=
DRIVE_FOLDER_HASIL_ID=

# ─────────────────────────────────────────────────────────────────────
# 3. APLIKASI (WAJIB)
# ─────────────────────────────────────────────────────────────────────
# Alamat aplikasi; dipakai untuk tautan verifikasi email & redirect OAuth
APP_BASE_URL=http://localhost:3000
ADMIN_EMAIL=bastantabangun2024@gmail.com

# 5. EMAIL (opsional — notifikasi pendaftaran)
# Resend: https://resend.com/api-keys
RESEND_API_KEY=
# Pengirim terverifikasi (default: onboarding@resend.dev, hanya untuk uji)
RESEND_FROM=Tool Tukin <onboarding@resend.dev>
# Kunci enkripsi refresh token Google yang disimpan di database.
# Buat dengan: openssl rand -base64 32
ENCRYPTION_KEY=GANTI_32_BYTE_BASE64
TZ=Asia/Jakarta

# ─────────────────────────────────────────────────────────────────────
# 4. OPSIONAL — hanya untuk CLI deploy, TIDAK dipakai aplikasi
#    (Vercel tidak memerlukan API key agar aplikasi berjalan;
#     deploy bisa lewat GitHub atau perintah `vercel`)
# ─────────────────────────────────────────────────────────────────────
VERCEL_TOKEN=

# Opsional — hanya untuk `node scripts/terapkan-migrasi.mjs` (bukan dipakai saat runtime).
SUPABASE_ACCESS_TOKEN=
